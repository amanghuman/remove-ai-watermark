  "type": "commonjs",
  "main": "lib/index.js",
  "bin": {
    "remove-ai-watermark": "bin/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "sharp": "^0.35.0"
  },
  "keywords": [
    "watermark",
    "watermark-remover",
    "remove-watermark",
    "c2pa",
    "exif",
    "steganography",
    "zero-width",
    "unicode",
    "sanitize",
    "cleaner",
    "image-processing",
    "cli"
  ],
  "author": "Aman Ghuman",
  "homepage": "https://amanghuman.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amanghuman/remove-ai-watermark.git"
  },
