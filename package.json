{
  "name": "remove-ai-watermark",
  "version": "1.0.0",
  "description": "Sanitize images, text documents, and codebases by removing C2PA manifests, EXIF metadata, invisible zero-width unicode watermarks, Bidi control characters, LLM prompt tokens, and steganography signals.",
